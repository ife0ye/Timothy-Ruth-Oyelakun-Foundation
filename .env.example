# Copy to .env.local for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Public URL of the site, no trailing slash (used for payment redirects and origin checks)
SITE_URL=http://localhost:5173

# Flutterwave → Settings → API Keys. Use FLWSECK_TEST-… locally, FLWSECK-… in production.
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Flutterwave → Settings → Webhooks → "Secret hash". Any long random string you choose;
# it must match exactly in both places. Generate one with: openssl rand -hex 32
FLW_WEBHOOK_HASH=

# Resend (resend.com) for the contact form and donation notifications.
RESEND_API_KEY=re_xxxxxxxx
# Must be an address on a domain you've verified in Resend
EMAIL_FROM=Timothy & Ruth Oyelakun Foundation <website@trofng.org>
# Where contact-form messages go
CONTACT_TO_EMAIL=info@trofng.org
# Optional: where donation alerts go (defaults to CONTACT_TO_EMAIL)
DONATION_NOTIFY_EMAIL=
